{
  "ignore": [
    "**/.git/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/target/**",
    "**/.next/**",
    "**/coverage/**",
    "**/.tmp/**",
    "**/__pycache__/**"
  ],
  "extensions": {
    ".js": "javascript",
    ".jsx": "javascript",
    ".mjs": "javascript",
    ".cjs": "javascript",
    ".ts": "typescript",
    ".tsx": "typescript",
    ".mts": "typescript",
    ".cts": "typescript",
    ".json": "json",
    ".py": "python",
    ".pyi": "python",
    ".go": "go",
    ".mod": "gomod",
    ".toml": "toml"
  },
  "rules": {
    "maintainable/single-use-helper": "error",
    "maintainable/object-spread-newline": "off",
    "maintainable/long-condition": "off",
    "maintainable/long-jsx-class-name": "off",
    "maintainable/playwright-style-assertion": "off",
    "maintainable/complex-mapped-button": "off",
    "max-depth": [
      "warn",
      2
    ],
    "complexity": [
      "warn",
      10
    ],
    "max-lines": [
      "warn",
      {
        "max": 300,
        "skipBlankLines": true,
        "skipComments": true
      }
    ]
  },
  "overrides": [],
  "externalChecks": [],
  "pythonRules": ["E4", "E7", "E9", "F"],
  "duplication": {
    "severity": "warn"
  }
}
